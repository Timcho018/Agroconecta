# Solo en el backend. NO subir .env a GitHub ni exponer la clave en Angular.
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
# Supabase > Connect > Session pooler > Connection string
DATABASE_URL=
# Supabase > Project Settings > API > Project URL
SUPABASE_URL=
# Supabase > Project Settings > API Keys > clave secreta sb_secret_* (solo servidor)
SUPABASE_SECRET_KEY=
# Compatibilidad con API keys antiguas de Supabase (usar SOLO si no tienes sb_secret_*)
SUPABASE_SERVICE_ROLE_KEY=
# Bucket PRIVADO creado desde Supabase > Storage
SUPABASE_STORAGE_BUCKET=agroconecta-private
